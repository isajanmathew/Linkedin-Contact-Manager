{
  "manifest_version": 3,
  "name": "LinkedIn to Airtable Contact Saver",
  "version": "1.1.0",
  "description": "Capture LinkedIn profile data and save contacts directly to Airtable.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://api.airtable.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Contact Saver"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
